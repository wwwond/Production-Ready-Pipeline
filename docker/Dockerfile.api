# ─────────────────────────────────────────
# Dockerfile.api
# ─────────────────────────────────────────
# 역할
# ----
# FastAPI 서버를 실행하는 컨테이너 이미지입니다.
#
# 빌드 과정
# ---------
# 1. Python 3.11 슬림 이미지 기반
# 2. 의존성 설치 (requirements.txt)
# 3. 프로젝트 코드 복사
# 4. uvicorn으로 FastAPI 서버 실행
#
# 포트
# ----
# 8000번 포트로 FastAPI 서버가 실행됩니다.
# docker-compose.yml에서 호스트 8000 → 컨테이너 8000으로 매핑합니다.
# ─────────────────────────────────────────

FROM python:3.11-slim

# 작업 디렉토리 설정
WORKDIR /app

# 시스템 패키지 설치 (OpenCV 의존성)
RUN apt-get update && apt-get install -y \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 의존성 먼저 설치 (코드 변경 시 캐시 활용)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 프로젝트 코드 복사
COPY . .

# FastAPI 서버 실행
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
